---
import { getRush } from '@rushcms/astro'
import Seo from '@rushcms/astro/components/seo.astro'
import type { Alternate, LocaleCode } from '@rushcms/client'
import Breadcrumb from '../components/breadcrumb.astro'
import Container from '../components/container.astro'
import Pager from '../components/pager.astro'
import type { Breadcrumb as BreadcrumbTrail } from '../lib/breadcrumb'
import { titleSuffix } from '../lib/document-title'
import { labelsFor } from '../lib/labels'
import { listPageHead } from '../lib/list-page'
import type { PageUrl } from '../lib/routing'
import { siteUrl } from '../lib/site-env'
import { bannerImage, loadSiteOptions } from '../lib/site-options'
import Base from './base.astro'

type Props = {
	locale: LocaleCode
	name: string
	page: number
	lastPage: number
	pageUrl: PageUrl
	alternates: Alternate[]
	empty: boolean
	description?: string | undefined
	breadcrumb?: BreadcrumbTrail | undefined
}

const { locale, name, page, lastPage, pageUrl, alternates, empty, description, breadcrumb } =
	Astro.props
const head = listPageHead({
	name,
	page,
	lastPage,
	pageUrl,
	site: siteUrl(Astro.site)
})
const rush = getRush(Astro)
const site = await rush.site.get()
const image = bannerImage(await loadSiteOptions(rush.siteOptions))
---

<Base locale={locale} title={{ from: 'seo' }} translations={alternates} socialImage={false}>
	<Seo
		slot="head"
		page={{
			locale,
			canonical: head.canonical ?? Astro.url.pathname,
			title: head.title,
			description,
			alternates: head.hreflang ? alternates : undefined,
			image
		}}
		titleSuffix={titleSuffix(site.name)}
	/>
	{empty && <meta slot="head" name="robots" content="noindex" />}
	{breadcrumb && <Breadcrumb trail={breadcrumb} />}
	<section
		class:list={[
			'relative overflow-hidden',
			breadcrumb ? 'pt-10 pb-20 md:pt-14 md:pb-32' : 'py-20 md:py-32'
		]}
	>
		<Container>
			<h1 class="mb-8 text-center text-4xl font-bold text-primary lg:text-6xl">{name}</h1>
			<slot />
			{empty && (
				<p class="text-center text-text-muted">{labelsFor(locale).emptyCollection}</p>
			)}
			<Pager locale={locale} current={page} last={lastPage} pageUrl={pageUrl} />
		</Container>
	</section>
</Base>
