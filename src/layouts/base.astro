---
import { getRush, getUrls, homepageAlternates } from '@rushcms/astro'
import PreviewBanner from '@rushcms/astro/components/preview-banner.astro'
import { toBcp47 } from '@rushcms/client'
import type { Alternate, LocaleCode } from '@rushcms/client'
import Analytics from '../components/analytics.astro'
import Footer from '../components/footer.astro'
import Header from '../components/header.astro'
import SearchDialog from '../components/search-dialog.astro'
import WhatsappFloat from '../components/whatsapp-float.astro'
import { labelsFor } from '../lib/labels'
import { languageLinks } from '../lib/locale'
import { contactLinks, loadSiteOptions } from '../lib/site-options'
import { socialImageTag } from '../lib/social-image'
import { whatsappUrl } from '../lib/whatsapp'
import { LEGAL_NAVIGATION, MAIN_NAVIGATION, siteNavigation } from '../lib/site-navigation'
import '../styles/global.css'

type Props = {
	locale: LocaleCode
	title?: string | undefined
	translations?: Alternate[]
	socialImage?: boolean
}

const { locale, title, translations = [], socialImage = true } = Astro.props
const urls = getUrls(Astro)
const rush = getRush(Astro)
const site = await rush.site.get()
const options = await loadSiteOptions(rush, locale)
const whatsapp = whatsappUrl(options.whatsappNumber, options.whatsappText)
const banner = socialImageTag(options.bannerUrl, socialImage)
const labels = labelsFor(locale)
const languages = languageLinks(homepageAlternates(urls), translations)
const mainLinks = await siteNavigation(Astro, MAIN_NAVIGATION)
const legalLinks = await siteNavigation(Astro, LEGAL_NAVIGATION)
---

<!doctype html>
<html lang={toBcp47(locale)} class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{title !== undefined && <title>{title}</title>}
		<slot name="head" />
		{banner !== undefined && <meta property="og:image" content={banner} />}
		<Analytics id={import.meta.env.GTAG} />
	</head>
	<body class="flex min-h-screen flex-col overflow-x-hidden bg-bg text-text-main antialiased selection:bg-primary selection:text-white">
		<a
			href="#content"
			class="sr-only rounded-md bg-primary px-4 py-2 font-medium text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[10000]"
		>
			{labels.skipToContent}
		</a>
		<PreviewBanner />
		<Header
			name={site.name}
			homeUrl={urls.homepage(locale)}
			locale={locale}
			links={mainLinks}
			languages={languages}
			labels={labels}
			logoUrl={options.logoUrl}
		/>
		<main id="content" tabindex="-1" class="flex-1 focus:outline-none">
			<slot />
		</main>
		<Footer
			name={site.name}
			locale={locale}
			links={legalLinks}
			contacts={contactLinks(options)}
			homeUrl={urls.homepage(locale)}
			floatingAction={whatsapp !== undefined}
		/>
		<SearchDialog locale={locale} labels={labels} />
		{whatsapp !== undefined && <WhatsappFloat href={whatsapp} label={labels.whatsappChat} />}
	</body>
</html>
