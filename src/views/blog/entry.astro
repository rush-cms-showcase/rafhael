---
import { getUrls } from '@rushcms/astro'
import { requireSite } from '@rushcms/astro/components-runtime'
import CategoryPills from '../../components/blog/category-pills.astro'
import PostMeta from '../../components/blog/post-meta.astro'
import Share from '../../components/blog/share.astro'
import TagList from '../../components/blog/tag-list.astro'
import ArticleTitle from '../../components/article-title.astro'
import Container from '../../components/container.astro'
import EntryCover from '../../components/entry-cover.astro'
import Prose from '../../components/prose.astro'
import EntryLayout from '../../layouts/entry-layout.astro'
import { entryCover } from '../../lib/entry-data'
import { ENTRY_WIDTHS } from '../../lib/entry-width'
import { markdownBody } from '../../lib/markdown'
import { readingTime } from '../../lib/reading-time'
import { absoluteUrl } from '../../lib/routing'
import type { EntryViewProps } from '../index'

type Props = EntryViewProps

const { entry, locale } = Astro.props
const urls = getUrls(Astro)
const shareUrl = absoluteUrl(urls.entry(entry), requireSite(Astro.site, 'blog entry'))
const width = ENTRY_WIDTHS.post
---

<EntryLayout entry={entry} locale={locale} kind="post">
	<div class="pt-10 pb-24 lg:pt-14">
		<article class="space-y-4">
			<Container class:list={['relative space-y-4 lg:space-y-6', width]}>
				<PostMeta
					minutes={readingTime(markdownBody(entry))}
					publishedAt={entry.published_at}
					locale={locale}
					size="post"
					class="border-b border-white/2 pb-6 lg:pb-8"
				/>
				<ArticleTitle title={entry.title} tone="accent" />
				<Share url={shareUrl} title={entry.title} locale={locale} class="lg:hidden" />
			</Container>
			<Container class:list={['relative', width]}>
				<div class="hidden lg:block absolute top-0 bottom-0 -left-20 w-16">
					<Share
						url={shareUrl}
						title={entry.title}
						locale={locale}
						class="sticky top-32 flex-col border border-primary/10 bg-black/5 gap-4 rounded-3xl p-4"
					/>
				</div>

				{entryCover(entry) && (
					<div class="rounded-3xl overflow-hidden shadow-2xl">
						<EntryCover
							entry={entry}
							class="w-full h-auto"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
				)}

				<CategoryPills
					categories={entry.categories}
					urls={urls}
					locale={locale}
					variant="post"
				/>

				<Prose entry={entry} />

				<TagList
					tags={entry.tags}
					urls={urls}
					locale={locale}
					class="pt-6 border-t border-border/30"
				/>
			</Container>
		</article>
	</div>
</EntryLayout>
