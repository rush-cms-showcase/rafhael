---
import { getRush, getUrls } from '@rushcms/astro'
import BlogListing from '../../components/blog/blog-listing.astro'
import CollectionListLayout from '../../layouts/collection-list-layout.astro'
import { loadCategoryFilters } from '../../lib/category-filters'
import type { ListViewProps } from '../index'

type Props = ListViewProps

const { page } = Astro.props
const urls = getUrls(Astro)
const filters = await loadCategoryFilters(getRush(Astro).tags, urls, page.locale, undefined)
---

<CollectionListLayout page={page}>
	<BlogListing filters={filters} entries={page.entries.items} locale={page.locale} urls={urls} />
</CollectionListLayout>
