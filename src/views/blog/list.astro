---
import { collectionAlternates, getRush, getUrls } from '@rushcms/astro'
import { requireSite } from '@rushcms/astro/components-runtime'
import Container from '../../components/container.astro'
import FilterPills from '../../components/blog/filter-pills.astro'
import PostGrid from '../../components/blog/post-grid.astro'
import Pager from '../../components/pager.astro'
import Base from '../../layouts/base.astro'
import { absoluteUrl, collectionPageUrl } from '../../lib/routing'
import { labelsFor } from '../../lib/labels'
import type { ListViewProps } from '../index'

type Props = ListViewProps

const { page } = Astro.props
const { collection, locale, entries, lastPage } = page
const urls = getUrls(Astro)
const rush = getRush(Astro)
const site = await rush.site.get()
const labels = labelsFor(locale)
const categories = await rush.tags.list({ type: 'category', locale })
const filters = categories.map((category) => ({
	name: category.name,
	href: urls.taxonomy(category, locale),
	active: false
}))
const pageUrl = collectionPageUrl(urls, collection, locale)
const canonical = absoluteUrl(
	urls.collection(collection, locale, page.page),
	requireSite(Astro.site, 'list view')
)
const translations = collectionAlternates(collection.id, urls)
---

<Base locale={locale} title={`${labels.blog} - ${site.name}`} translations={translations}>
	<meta slot="head" name="description" content={labels.blogDescription} />
	{canonical && <link slot="head" rel="canonical" href={canonical} />}
	<section class="py-20 md:py-32 relative overflow-hidden">
		<Container>
			<div class="text-center">
				<h1 class="text-primary text-4xl lg:text-6xl font-bold mb-8">{labels.blog}</h1>
			</div>
			<div class="w-full">
				<FilterPills
					allHref={urls.collection(collection, locale)}
					allLabel={labels.allCategories}
					filters={filters}
				/>
				<PostGrid entries={entries.items} locale={locale} urls={urls} />

				<Pager locale={locale} current={page.page} last={lastPage} pageUrl={pageUrl} />
			</div>
		</Container>
	</section>
</Base>
