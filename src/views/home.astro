---
import { getRush, homepageTitle } from '@rushcms/astro'
import Seo from '@rushcms/astro/components/seo.astro'
import Container from '../components/container.astro'
import Base from '../layouts/base.astro'
import type { HomeViewProps } from './index'

type Props = HomeViewProps

const { page } = Astro.props
const { locale, homepage } = page
const site = await getRush(Astro).site.get()
const title = homepageTitle(homepage) === undefined ? site.name : undefined
---

<Base locale={locale} title={title}>
	{homepage && <Seo slot="head" homepage={homepage} />}
	<Container class="py-24">
		<h1 class="font-serif text-4xl font-bold">{site.name}</h1>
	</Container>
</Base>
