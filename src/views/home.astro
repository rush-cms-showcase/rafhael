---
import { getRush, getUrls, homepageTitle } from '@rushcms/astro'
import Seo from '@rushcms/astro/components/seo.astro'
import Hero from '../components/home/hero.astro'
import Loop from '../components/home/loop.astro'
import Base from '../layouts/base.astro'
import { loadLoopEntries } from '../lib/home-loop'
import { homeSections } from '../lib/home-sections'
import type { HomeViewProps } from './index'

type Props = HomeViewProps

const { page } = Astro.props
const { locale, homepage } = page
const rush = getRush(Astro)
const urls = getUrls(Astro)
const site = await rush.site.get()
const title = homepageTitle(homepage) === undefined ? site.name : undefined
const sections = await Promise.all(
	homeSections(homepage?.content ?? []).map(async (section) => ({
		section,
		entries: section.kind === 'loop' ? await loadLoopEntries(rush.entries, section, locale) : []
	}))
)
---

<Base locale={locale} title={title}>
	{homepage && <Seo slot="head" homepage={homepage} />}
	{sections.map(({ section, entries }) =>
		section.kind === 'hero' ? (
			<Hero section={section} />
		) : (
			<Loop section={section} entries={entries} locale={locale} urls={urls} />
		)
	)}
</Base>
