---
import { collectionAlternates, getRush, getUrls } from '@rushcms/astro'
import CaseRows from '../../components/case-rows.astro'
import Container from '../../components/container.astro'
import Pager from '../../components/pager.astro'
import Base from '../../layouts/base.astro'
import type { ListViewProps } from '../index'
import { collectionCanonical } from '../../lib/collection-canonical'
import { collectionPageUrl } from '../../lib/page-url'

type Props = ListViewProps

const { page } = Astro.props
const { collection, locale, entries, lastPage } = page
const urls = getUrls(Astro)
const site = await getRush(Astro).site.get()
const canonical = collectionCanonical(urls, collection, locale, page.page, Astro.site)
---

<Base
	locale={locale}
	title={`${collection.name} | ${site.name}`}
	translations={collectionAlternates(collection.id, urls)}
>
	{canonical && <link slot="head" rel="canonical" href={canonical} />}
	<Container class="py-16 lg:py-24">
		<h1 class="mb-12 font-serif text-5xl font-bold text-primary lg:mb-16 lg:text-7xl">
			{collection.name}
		</h1>
		<CaseRows
			entries={entries.items}
			locale={locale}
			urls={urls}
			start={(page.page - 1) * entries.meta.per_page + 1}
			detailed
		/>
		<Pager
			locale={locale}
			current={page.page}
			last={lastPage}
			pageUrl={collectionPageUrl(urls, collection, locale)}
		/>
	</Container>
</Base>
