---
import CaseArticle from '../../components/case-article.astro'
import EntryLayout from '../../layouts/entry-layout.astro'
import type { EntryViewProps } from '../index'

type Props = EntryViewProps

const { entry, locale } = Astro.props
---

<EntryLayout entry={entry} locale={locale} kind="case">
	<CaseArticle entry={entry} locale={locale} />
</EntryLayout>
