---
import { getLocale, getRush, getUrls } from '@rushcms/astro'
import Base from '../layouts/base.astro'
import { labelsFor } from '../lib/labels'

const locale = getLocale(Astro)
const site = await getRush(Astro).site.get()
const labels = labelsFor(locale)
---

<Base locale={locale} title={`${labels.notFoundTitle} | ${site.name}`}>
	<meta slot="head" name="robots" content="noindex" />
	<div class="mx-auto flex max-w-3xl flex-col items-start px-6 py-24 sm:py-32">
		<p class="font-mono text-sm text-primary">404</p>
		<h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
			{labels.notFoundTitle}
		</h1>
		<p class="mt-6 text-lg text-text-muted">{labels.notFoundText}</p>
		<a
			href={getUrls(Astro).homepage(locale)}
			class="mt-10 inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-primary-hover"
		>
			{labels.backHome}
		</a>
	</div>
</Base>
