---
import { getRush, getUrls } from '@rushcms/astro'
import BlogListing from '../components/blog/blog-listing.astro'
import ListLayout from '../layouts/list-layout.astro'
import { breadcrumbTrail } from '../lib/breadcrumb'
import { loadCategoryFilters } from '../lib/category-filters'
import { taxonomyPageUrl } from '../lib/routing'
import type { TaxonomyViewProps } from './index'

type Props = TaxonomyViewProps

const { page } = Astro.props
const { tag, locale, entries, lastPage, alternates } = page
const urls = getUrls(Astro)
const pageUrl = taxonomyPageUrl(urls, tag, locale)
const filters =
	tag.type === 'category'
		? await loadCategoryFilters(getRush(Astro).tags, urls, locale, tag.id)
		: undefined
const breadcrumb = breadcrumbTrail({
	kind: tag.type,
	locale,
	urls,
	title: tag.name,
	path: pageUrl(page.page)
})
---

<ListLayout
	locale={locale}
	name={tag.name}
	page={page.page}
	lastPage={lastPage}
	pageUrl={pageUrl}
	alternates={alternates}
	empty={entries.items.length === 0}
	breadcrumb={breadcrumb}
>
	<BlogListing filters={filters} entries={entries.items} locale={locale} urls={urls} />
</ListLayout>
