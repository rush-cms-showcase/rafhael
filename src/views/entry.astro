---
import RichText from '@rushcms/astro/components/rich-text.astro'
import { isRichText } from '@rushcms/client'
import ArticleShell from '../components/article-shell.astro'
import ArticleTitle from '../components/article-title.astro'
import EntryCover from '../components/entry-cover.astro'
import EntryLayout from '../layouts/entry-layout.astro'
import { ENTRY_COVER_SIZES } from '../lib/cover-sizes'
import { formatDate } from '../lib/format-date'
import type { EntryViewProps } from './index'

type Props = EntryViewProps

const { entry, locale } = Astro.props
const documents = Object.values(entry.data).filter(isRichText)
---

<EntryLayout entry={entry} locale={locale} kind="page">
	<ArticleShell kind="page">
		<header class="flex flex-col gap-4">
			<ArticleTitle title={entry.title} tone="plain" />
			<p class="text-sm text-text-muted">
				<time datetime={entry.published_at}>
					{formatDate(entry.published_at, entry.locale)}
				</time>
				{entry.author && <span> &middot; {entry.author.name}</span>}
			</p>
			{entry.excerpt && (
				<p class="mt-4 text-xl text-pretty text-text-muted">{entry.excerpt}</p>
			)}
		</header>
		<EntryCover entry={entry} sizes={ENTRY_COVER_SIZES} priority class="w-full rounded-xl" />
		{documents.length > 0 && (
			<div class="prose prose-lg max-w-none">
				{documents.map((content) => (
					<RichText content={content} media={entry.media} />
				))}
			</div>
		)}
	</ArticleShell>
</EntryLayout>
