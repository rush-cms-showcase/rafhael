---
import { getUrls } from '@rushcms/astro'
import EntryGrid from '../../components/entry-grid.astro'
import CollectionListLayout from '../../layouts/collection-list-layout.astro'
import type { ListViewProps } from '../index'

type Props = ListViewProps

const { page } = Astro.props
const urls = getUrls(Astro)
---

<CollectionListLayout page={page}>
	<EntryGrid
		entries={page.entries.items}
		locale={page.locale}
		urls={urls}
		layout="projects"
		headingLevel="h2"
	/>
</CollectionListLayout>
