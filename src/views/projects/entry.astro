---
import ProjectArticle from '../../components/project-article.astro'
import EntryLayout from '../../layouts/entry-layout.astro'
import type { EntryViewProps } from '../index'

type Props = EntryViewProps

const { entry, locale } = Astro.props
---

<EntryLayout entry={entry} locale={locale} kind="project">
	<ProjectArticle entry={entry} locale={locale} />
</EntryLayout>
