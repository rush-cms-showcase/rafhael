---
import { caseMeta } from '../lib/entry-data'
import type { CaseLink } from '../lib/case-link'
import { Icons } from '../lib/icons'
import CaseStack from './case-stack.astro'

type Props = CaseLink

const { entry, href } = Astro.props
const { clientName, role, stack } = caseMeta(entry)
const context = [clientName, role].filter((part) => part !== '')
---

<a
	href={href}
	class="group flex items-start justify-between gap-8 py-10 transition-colors lg:py-14"
>
	<span class="flex min-w-0 flex-col gap-4">
		{context.length > 0 && (
			<span class="text-sm font-medium tracking-wide text-text-subtle uppercase">
				{context.join(' · ')}
			</span>
		)}
		<span class="font-serif text-3xl leading-tight font-bold text-text-main text-balance transition-colors group-hover:text-primary lg:text-5xl">
			{entry.title}
		</span>
		{entry.excerpt && (
			<span class="max-w-2xl text-lg text-pretty text-text-muted">{entry.excerpt}</span>
		)}
		<CaseStack stack={stack} />
	</span>
	<Icons.arrow_right class="mt-2 h-7 w-7 shrink-0 text-text-subtle transition group-hover:translate-x-1 group-hover:text-primary lg:mt-4" />
</a>
