---
import type { LocaleCode } from '@rushcms/client'
import { Icons } from '../lib/icons'
import { labelsFor } from '../lib/labels'

type Props = {
	href: string
	locale: LocaleCode
}

const { href, locale } = Astro.props
---

<a
	href={href}
	target="_blank"
	rel="noopener"
	aria-label={labelsFor(locale).whatsappChat}
	class="fixed right-4 bottom-4 z-50 flex size-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-lg transition-transform hover:scale-110 lg:right-8 lg:bottom-8"
>
	<Icons.whatsapp class="size-7" />
</a>
