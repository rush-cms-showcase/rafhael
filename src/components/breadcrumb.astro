---
import type { Breadcrumb } from '../lib/breadcrumb'
import { breadcrumbJsonLd } from '../lib/breadcrumb'
import { Icons } from '../lib/icons'
import { siteUrl } from '../lib/site-env'
import Container from './container.astro'
import JsonLd from './json-ld.astro'

type Props = {
	trail: Breadcrumb
	class?: string | undefined
}

const { trail, class: className } = Astro.props
const links = trail.section === undefined ? [] : [trail.section]
const data = breadcrumbJsonLd(trail, siteUrl(Astro.site))
---

<Container class:list={['pt-6 lg:pt-8', className]}>
	<nav aria-label={trail.label}>
		<ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-text-subtle">
			<li class="flex items-center">
				<a
					href={trail.home.href}
					class="flex items-center rounded-sm p-0.5 transition-colors hover:text-primary"
				>
					<Icons.house class="size-4" aria-hidden="true" />
					<span class="sr-only">{trail.home.label}</span>
				</a>
			</li>
			{links.map((link) => (
				<li class="flex items-center gap-1.5">
					<Icons.chevron_right class="size-3.5 text-border" aria-hidden="true" />
					<a href={link.href} class="transition-colors hover:text-primary">
						{link.label}
					</a>
				</li>
			))}
			<li class="flex items-center gap-1.5">
				<Icons.chevron_right class="size-3.5 text-border" aria-hidden="true" />
				<span aria-current="page" class="text-text-muted">
					{trail.current.label}
				</span>
			</li>
		</ol>
	</nav>
	<JsonLd data={data} />
</Container>
