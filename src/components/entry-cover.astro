---
import RushImage from '@rushcms/astro/components/rush-image.astro'
import type { Entry } from '@rushcms/client'
import { entryCover } from '../lib/entry-data'

type Props = {
	entry: Entry
	class?: string | undefined
	sizes?: string
	aspectRatio?: number
	priority?: boolean
}

const { entry, class: className, ...image } = Astro.props
const cover = entryCover(entry)
---

{cover && <RushImage media={cover} alt={cover.alt || entry.title} class={className} {...image} />}
