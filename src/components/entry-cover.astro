---
import { getRush } from '@rushcms/astro'
import RushImage from '@rushcms/astro/components/rush-image.astro'
import type { Entry } from '@rushcms/client'
import { entryCover } from '../lib/entry-data'
import { mediaAlt } from '../lib/media-alt'

type Props = {
	entry: Entry
	class?: string | undefined
	sizes?: string
	aspectRatio?: number
	priority?: boolean
}

const { entry, class: className, ...image } = Astro.props
const cover = entryCover(entry)
const site = cover === undefined ? undefined : await getRush(Astro).site.get()
---

{cover && site && (
	<RushImage
		media={cover}
		alt={mediaAlt(cover.alt, entry.title, site.name)}
		class={className}
		{...image}
	/>
)}
