---
import type { LinkableNavigation } from '../lib/locale'
import NavLink from './nav-link.astro'

type Props = {
	links: LinkableNavigation[]
}

const { links } = Astro.props
---

<nav class="mr-8 ml-auto hidden items-center gap-10 md:flex">
	{links.map((link) => (
		<NavLink
			link={link}
			class="text-sm font-medium text-text-muted transition-colors hover:text-text-main lg:text-lg"
		/>
	))}
</nav>
