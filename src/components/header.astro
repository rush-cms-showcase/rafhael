---
import type { LocaleCode } from '@rushcms/client'
import { Icons } from '../lib/icons'
import { labelsFor } from '../lib/labels'
import type { LanguageLink, LinkableNavigation } from '../lib/locale'
import Container from './container.astro'
import HeaderLogo from './header-logo.astro'
import HeaderNav from './header-nav.astro'
import LanguageSelector from './language-selector.astro'
import MobileMenu from './mobile-menu.astro'

type Props = {
	name: string
	homeUrl: string
	locale: LocaleCode
	links: LinkableNavigation[]
	languages: LanguageLink[]
	logoUrl?: string | undefined
}

const { name, homeUrl, locale, links, languages, logoUrl } = Astro.props
const labels = labelsFor(locale)
const SearchIcon = Icons.search
---

<header class="sticky top-0 right-0 left-0 z-50 border-b border-border/50 bg-bg/95 py-5 backdrop-blur-md transition-all duration-300">
	<Container class="flex items-center justify-between">
		<HeaderLogo homeUrl={homeUrl} name={name} logoUrl={logoUrl} />
		<HeaderNav links={links} />

		<div class="flex items-center gap-4">
			<button
				id="search-trigger"
				type="button"
				aria-haspopup="dialog"
				aria-keyshortcuts="Control+K Meta+K"
				class="group relative flex h-10 w-10 items-center justify-center rounded-lg text-text-muted transition-colors hover:bg-bg-elevated hover:text-primary"
				aria-label={labels.search}
			>
				<SearchIcon class="h-5 w-5" />
				<span
					aria-hidden="true"
					class="pointer-events-none absolute -top-1.5 -right-1.5 flex h-4 min-w-6 items-center justify-center rounded border border-border/50 bg-bg-elevated/90 px-0.5 text-[9px] font-bold whitespace-nowrap text-text-muted shadow-sm backdrop-blur-sm transition-colors group-hover:border-primary/50 group-hover:text-primary"
				>
					{labels.searchShortcut}
				</span>
			</button>

			<div class="hidden px-2 lg:block">
				<LanguageSelector current={locale} links={languages} />
			</div>

			<MobileMenu links={links} languages={languages} locale={locale} />
		</div>
	</Container>
</header>
