---
import type { Entry, RushUrls } from '@rushcms/client'
import CaseRow from './case-row.astro'

type Props = {
	entries: Entry[]
	urls: RushUrls
	detailed?: boolean | undefined
}

const { entries, urls, detailed = false } = Astro.props
---

<ol class="animate-fade-in divide-y divide-border border-t border-border">
	{entries.map((entry) => (
		<li>
			<CaseRow entry={entry} href={urls.entry(entry)} detailed={detailed} />
		</li>
	))}
</ol>
