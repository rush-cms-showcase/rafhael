---
import type { Entry, LocaleCode, RushUrls } from '@rushcms/client'
import CaseRow from './case-row.astro'

type Props = {
	entries: Entry[]
	locale: LocaleCode
	urls: RushUrls
	detailed?: boolean | undefined
}

const { entries, locale, urls, detailed = false } = Astro.props
---

<ol class="animate-fade-in divide-y divide-border border-t border-border">
	{entries.map((entry) => (
		<li>
			<CaseRow entry={entry} href={urls.servedPath(entry, locale)} detailed={detailed} />
		</li>
	))}
</ol>
