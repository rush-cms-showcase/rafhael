---
import type { LocaleCode } from '@rushcms/client'
import { Icons } from '../../lib/icons'
import type { IconName } from '../../lib/icons'
import { labelsFor } from '../../lib/labels'
import { shareUrl } from '../../lib/share'
import type { SharePlatform } from '../../lib/share'

type ShareButton = {
	platform: SharePlatform
	icon: IconName
	label: string
}

type Props = {
	url: string
	title: string
	locale: LocaleCode
	class?: string | undefined
}

const { url, title, locale, class: className } = Astro.props
const labels = labelsFor(locale)
const buttons: ShareButton[] = [
	{ platform: 'x', icon: 'twitter_x', label: labels.shareOnX },
	{ platform: 'linkedin', icon: 'linkedin', label: labels.shareOnLinkedin },
	{ platform: 'whatsapp', icon: 'whatsapp', label: labels.shareOnWhatsapp }
]
const buttonClass =
	'size-9 rounded-full bg-bg-elevated hover:bg-bg-elevated/80 border border-border flex items-center justify-center transition-colors'
const CopyIcon = Icons.copy
const CheckIcon = Icons.check
---

<div class:list={['flex items-center gap-2', className]}>
	{buttons.map((button) => {
		const Icon = Icons[button.icon]
		return (
			<button
				type="button"
				class:list={['share-btn', buttonClass]}
				data-share-url={shareUrl(button.platform, { url, title })}
				aria-label={button.label}
			>
				<Icon class="size-4" />
			</button>
		)
	})}
	<button
		type="button"
		class:list={['copy-url-btn', buttonClass]}
		data-url={url}
		aria-label={labels.copyLink}
	>
		<CopyIcon class="copy-url-icon size-4" />
		<CheckIcon class="check-icon size-4 hidden" />
	</button>
</div>

<script>
	const COPIED_MS = 2000

	document.querySelectorAll<HTMLButtonElement>('.share-btn').forEach((button) => {
		button.addEventListener('click', () => {
			window.open(button.dataset.shareUrl, '_blank', 'width=600,height=400')
		})
	})

	document.querySelectorAll<HTMLButtonElement>('.copy-url-btn').forEach((button) => {
		button.addEventListener('click', async () => {
			await navigator.clipboard.writeText(button.dataset.url ?? '')
			const copyIcon = button.querySelector('.copy-url-icon')
			const checkIcon = button.querySelector('.check-icon')
			copyIcon?.classList.add('hidden')
			checkIcon?.classList.remove('hidden')
			setTimeout(() => {
				copyIcon?.classList.remove('hidden')
				checkIcon?.classList.add('hidden')
			}, COPIED_MS)
		})
	})
</script>
