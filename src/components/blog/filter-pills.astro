---
import type { LocaleCode } from '@rushcms/client'
import type { CategoryFilters } from '../../lib/category-filters'
import { labelsFor } from '../../lib/labels'

type Props = {
	filters: CategoryFilters
	locale: LocaleCode
}

const { filters, locale } = Astro.props
const pillBase = 'px-4 py-2 rounded-full text-sm font-medium transition-colors'
const pillActive = `${pillBase} bg-primary text-white shadow-lg`
const pillIdle = `${pillBase} bg-bg-elevated text-text-muted hover:bg-bg-elevated/80 hover:text-primary border border-border`
const allActive = !filters.filters.some((filter) => filter.active)
---

<div class="flex flex-wrap justify-center gap-3 mb-12 animate-fade-in">
	<a
		href={filters.allHref}
		aria-current={allActive ? 'page' : undefined}
		class={allActive ? pillActive : pillIdle}
	>
		{labelsFor(locale).allCategories}
	</a>
	{filters.filters.map((filter) =>
		filter.href === undefined ? (
			<span class={pillIdle}>{filter.name}</span>
		) : (
			<a
				href={filter.href}
				aria-current={filter.active ? 'page' : undefined}
				class={filter.active ? pillActive : pillIdle}
			>
				{filter.name}
			</a>
		)
	)}
</div>
