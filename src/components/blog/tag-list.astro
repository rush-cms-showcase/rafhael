---
import type { LocaleCode, RushUrls, TagRef } from '@rushcms/client'
import { labelsFor } from '../../lib/labels'
import { termLink } from '../../lib/routing'
import MaybeLink from '../maybe-link.astro'

type Props = {
	tags: TagRef[]
	urls: RushUrls
	locale: LocaleCode
	class?: string | undefined
}

const { tags, urls, locale, class: className } = Astro.props
const labels = labelsFor(locale)
const chipClass =
	'px-3 py-1 bg-bg-elevated border border-border rounded-lg text-sm text-text-subtle hover:text-primary hover:border-primary/30 transition-colors'
const chips = tags.map((tag) => termLink(urls, tag, locale))
---

{chips.length > 0 && (
	<div class:list={[className]}>
		<h3 class="text-sm uppercase tracking-widest text-text-muted mb-4 font-bold">
			{labels.tags}
		</h3>
		<div class="flex flex-wrap gap-2">
			{chips.map((chip) => (
				<MaybeLink href={chip.href} class={chipClass}>
					{chip.name}
				</MaybeLink>
			))}
		</div>
	</div>
)}
