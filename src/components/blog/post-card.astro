---
import type { Entry, LocaleCode, RushUrls } from '@rushcms/client'
import { CARD_ASPECT_RATIO, POST_CARD_SIZES } from '../../lib/cover-sizes'
import { entryCover } from '../../lib/entry-data'
import { DEFAULT_HEADING } from '../../lib/heading'
import type { HeadingLevel } from '../../lib/heading'
import { labelsFor } from '../../lib/labels'
import { markdownBody } from '../../lib/markdown'
import { readingTime } from '../../lib/reading-time'
import ArrowLink from '../arrow-link.astro'
import Card from '../card.astro'
import EntryCover from '../entry-cover.astro'
import CategoryPills from './category-pills.astro'
import PostMeta from './post-meta.astro'

type Props = {
	entry: Entry
	locale: LocaleCode
	urls: RushUrls
	headingLevel?: HeadingLevel | undefined
}

const { entry, locale, urls, headingLevel = DEFAULT_HEADING } = Astro.props
const Heading = headingLevel
const href = urls.entry(entry)
const hasImage = entryCover(entry) !== undefined
---

<Card class:list={[{ 'animate-fade-in': !hasImage }]}>
	{hasImage && (
		<div class="relative aspect-video overflow-hidden block">
			<a href={href} class="block size-full">
				<EntryCover
					entry={entry}
					sizes={POST_CARD_SIZES}
					aspectRatio={CARD_ASPECT_RATIO}
					class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
				/>
			</a>
			<CategoryPills
				categories={entry.categories}
				urls={urls}
				locale={locale}
				variant="overlay"
			/>
		</div>
	)}

	<div class:list={['flex-1 p-6 flex flex-col', { 'justify-center': !hasImage }]}>
		{!hasImage && (
			<CategoryPills
				categories={entry.categories}
				urls={urls}
				locale={locale}
				variant="card"
			/>
		)}

		<a href={href} class="group-hover:text-primary transition-colors block">
			<Heading
				class:list={[
					'font-serif font-bold mb-3 leading-tight group-hover:underline',
					hasImage ? 'text-2xl' : 'text-3xl md:text-4xl'
				]}
			>
				{entry.title}
			</Heading>
		</a>

		<div class="flex items-center justify-between pt-6 mt-auto">
			<PostMeta
				minutes={readingTime(markdownBody(entry))}
				publishedAt={entry.published_at}
				locale={locale}
				size="card"
			/>
			<ArrowLink href={href} label={labelsFor(locale).readArticle} tone="accent" />
		</div>
	</div>
</Card>
