---
import type { Entry, LocaleCode, RushUrls } from '@rushcms/client'
import RushImage from '@rushcms/astro/components/rush-image.astro'
import { Icons } from '../../lib/icons'
import { labelsFor } from '../../lib/labels'
import { markdownBody } from '../../lib/markdown'
import { readingTime } from '../../lib/reading-time'
import CategoryPills from './category-pills.astro'
import PostMeta from './post-meta.astro'

type Props = {
	entry: Entry
	locale: LocaleCode
	urls: RushUrls
}

const { entry, locale, urls } = Astro.props
const labels = labelsFor(locale)
const href = urls.entry(entry)
const cover = entry.featured_image?.url === undefined ? undefined : entry.featured_image
const hasImage = cover !== undefined
const ArrowRightIcon = Icons.arrow_right
const meta = {
	minutes: readingTime(markdownBody(entry)),
	publishedAt: entry.published_at,
	locale
}
---

<article
	class:list={[
		'group flex flex-col bg-bg-card border border-primary/10 rounded-2xl overflow-hidden hover:border-primary/50 transition-all duration-300 hover:-translate-y-1',
		{ 'animate-fade-in': !hasImage }
	]}
>
	{cover && (
		<div class="relative aspect-video overflow-hidden block">
			<a href={href} class="block w-full h-full">
				<RushImage
					media={cover}
					alt={cover.alt || entry.title}
					class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
					loading="lazy"
				/>
			</a>
			<CategoryPills
				categories={entry.categories}
				urls={urls}
				locale={locale}
				variant="overlay"
			/>
		</div>
	)}

	<div class:list={['flex-1 p-6 flex flex-col', { 'justify-center': !hasImage }]}>
		{!hasImage && (
			<CategoryPills
				categories={entry.categories}
				urls={urls}
				locale={locale}
				variant="card"
			/>
		)}

		<a href={href} class="group-hover:text-primary transition-colors block">
			<h3
				class:list={[
					'font-serif font-bold mb-3 leading-tight group-hover:underline',
					hasImage ? 'text-2xl' : 'text-3xl md:text-4xl'
				]}
			>
				{entry.title}
			</h3>
		</a>

		<div class="flex items-center justify-between pt-6 mt-auto">
			<PostMeta {...meta} size="card" />

			<a
				href={href}
				class="text-sm font-bold text-primary flex items-center gap-1 group/link"
			>
				{labels.readArticle}
				<ArrowRightIcon class="w-4 h-4 transition-transform group-hover/link:translate-x-1" />
			</a>
		</div>
	</div>
</article>
