---
import { getUrls, homepageAlternates } from '@rushcms/astro'
import type { Alternate, LocaleCode } from '@rushcms/client'
import { languageName } from '../lib/locale'

type Props = {
	locale: LocaleCode
	translations: Alternate[]
}

const { locale, translations } = Astro.props
const links = homepageAlternates(getUrls(Astro)).map((home) => ({
	...home,
	label: languageName(home.locale),
	url: translations.find((translation) => translation.locale === home.locale)?.url ?? home.url
}))
---

{
	links.length > 1 && (
		<nav aria-label="Language" class="text-sm">
			<ul class="flex flex-wrap items-center gap-1">
				{links.map((link) => (
					<li>
						<a
							href={link.url}
							hreflang={link.hreflang}
							lang={link.hreflang}
							aria-current={link.locale === locale ? 'true' : undefined}
							class="block rounded-full px-3 py-1 text-muted transition-colors hover:text-ink aria-[current]:bg-accent-soft aria-[current]:text-ink"
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}
