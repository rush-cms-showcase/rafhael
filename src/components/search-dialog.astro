---
import type { LocaleCode } from '@rushcms/client'
import { Icons } from '../lib/icons'
import { kindLabels, labelsFor } from '../lib/labels'
import { searchIndexPath } from '../lib/search-index'

type Props = {
	locale: LocaleCode
}

const { locale } = Astro.props
const labels = labelsFor(locale)
const SearchIcon = Icons.search
const CloseIcon = Icons.x
const ArrowIcon = Icons.arrow_right
---

<dialog
	id="search-dialog"
	aria-modal="true"
	aria-label={labels.search}
	data-index-url={searchIndexPath(locale)}
	data-kind-labels={JSON.stringify(kindLabels(labels))}
	class="mx-auto mt-[10vh] w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-2xl border border-border bg-bg-elevated p-0 text-text-main shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm"
>
	<div class="flex items-center gap-3 border-b border-border px-4">
		<SearchIcon class="size-5 shrink-0 text-text-subtle" aria-hidden="true" />
		<label for="search-input" class="sr-only">
			{labels.search}
		</label>
		<input
			id="search-input"
			type="text"
			role="combobox"
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
			aria-expanded="false"
			aria-controls="search-results"
			aria-autocomplete="list"
			placeholder={labels.searchPlaceholder}
			class="h-14 min-w-0 flex-1 bg-transparent text-base text-text-main placeholder:text-text-subtle focus:outline-none"
		/>
		<button
			type="button"
			data-search-close
			aria-label={labels.searchClose}
			class="flex size-8 shrink-0 items-center justify-center rounded-md text-text-muted transition-colors hover:bg-bg-card hover:text-primary"
		>
			<CloseIcon class="size-4" aria-hidden="true" />
		</button>
	</div>

	<div class="max-h-[60vh] overflow-y-auto">
		<div role="status" class="text-center text-sm text-text-muted [&>p]:px-4 [&>p]:py-8">
			<p data-status="idle">{labels.searchEmpty}</p>
			<p data-status="loading" hidden>
				{labels.searchLoading}
			</p>
			<p data-status="error" hidden>
				{labels.searchError}
			</p>
			<p data-status="none" hidden>
				{labels.searchNoResults} <span data-query class="font-medium text-text-main"></span>
			</p>
		</div>
		<div
			id="search-results"
			role="listbox"
			aria-label={labels.searchResults}
			hidden
			class="space-y-3 p-2"
		></div>
	</div>

	<template id="search-group-template">
		<div role="group" class="space-y-1">
			<p
				data-group-title
				class="px-3 pt-2 text-xs font-medium tracking-widest text-text-subtle uppercase"
			></p>
		</div>
	</template>

	<template id="search-option-template">
		<a
			role="option"
			class="group flex items-center justify-between gap-4 rounded-lg px-3 py-2.5 text-text-main aria-selected:bg-bg-card aria-selected:text-primary"
		>
			<span class="flex min-w-0 flex-col gap-0.5">
				<span data-option-title class="truncate font-medium"></span>
				<span data-option-excerpt class="truncate text-sm text-text-muted"></span>
			</span>
			<ArrowIcon
				class="size-4 shrink-0 text-text-subtle group-aria-selected:text-primary"
				aria-hidden="true"
			/>
		</a>
	</template>
</dialog>

<script>
	import '../scripts/search'
</script>
