---
import type { Entry, LocaleCode, RushUrls } from '@rushcms/client'
import ProjectCard from './project-card.astro'

type Props = {
	entries: Entry[]
	locale: LocaleCode
	urls: RushUrls
}

const { entries, locale, urls } = Astro.props
---

<div class="grid animate-fade-in gap-8 md:grid-cols-2">
	{entries.map((entry) => (
		<ProjectCard entry={entry} locale={locale} urls={urls} />
	))}
</div>
