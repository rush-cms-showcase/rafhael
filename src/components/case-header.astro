---
import type { Entry } from '@rushcms/client'
import { caseMeta } from '../lib/entry-data'
import type { Labels } from '../lib/labels'
import CaseStack from './case-stack.astro'

type Props = {
	entry: Entry
	labels: Labels
}

type Fact = {
	label: string
	value: string
}

const { entry, labels } = Astro.props
const { clientName, role, period, stack } = caseMeta(entry)
const facts: Fact[] = [
	{ label: labels.caseClient, value: clientName },
	{ label: labels.caseRole, value: role },
	{ label: labels.casePeriod, value: period }
].filter((fact) => fact.value !== '')
---

<header class="flex flex-col gap-10">
	<h1 class="font-serif text-4xl leading-tight font-bold text-text-main text-balance lg:text-5xl">
		{entry.title}
	</h1>
	{entry.excerpt && <p class="max-w-2xl text-xl text-pretty text-text-muted">{entry.excerpt}</p>}
	{(facts.length > 0 || stack.length > 0) && (
		<div class="flex flex-col gap-8 border-y border-border py-8">
			{facts.length > 0 && (
				<dl class="grid gap-8 sm:grid-cols-3">
					{facts.map((fact) => (
						<div class="flex flex-col gap-1">
							<dt class="text-sm font-medium tracking-wide text-text-subtle uppercase">
								{fact.label}
							</dt>
							<dd class="text-lg text-text-main">{fact.value}</dd>
						</div>
					))}
				</dl>
			)}
			{stack.length > 0 && (
				<div class="flex flex-col gap-3">
					<p class="text-sm font-medium tracking-wide text-text-subtle uppercase">
						{labels.caseStack}
					</p>
					<CaseStack stack={stack} />
				</div>
			)}
		</div>
	)}
</header>
