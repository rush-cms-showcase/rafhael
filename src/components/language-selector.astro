---
import type { LocaleCode } from '@rushcms/client'
import { Icons } from '../lib/icons'
import { labelsFor } from '../lib/labels'
import type { LanguageLink } from '../lib/locale'
import LanguageOption from './language-option.astro'

type Props = {
	current: LocaleCode
	links: LanguageLink[]
	inline?: boolean
}

const { current, links, inline = false } = Astro.props
const label = labelsFor(current).selectLanguage
const GlobeIcon = Icons.globe
const ChevronDownIcon = Icons.chevron_down
const currentCode = links.find((link) => link.locale === current)?.code
---

{links.length > 1 &&
	(inline ? (
		<div class="flex items-center justify-center gap-4">
			{links.map((link) => (
				<LanguageOption link={link} current={current} variant="pill" />
			))}
		</div>
	) : (
		<div class="group relative z-50" data-language-menu>
			<button
				type="button"
				class="flex items-center gap-2 py-2 text-sm font-medium text-text-muted transition-colors hover:text-text-main"
				aria-label={label}
				aria-haspopup="true"
				aria-expanded="false"
			>
				<GlobeIcon class="size-4" />
				<span class="uppercase">{currentCode}</span>
				<ChevronDownIcon class="size-3.5 transition-transform group-hover:rotate-180" />
			</button>

			<div class="invisible absolute top-full right-0 mt-2 w-24 origin-top-right transform rounded-lg border border-white/10 bg-bg-elevated py-2 opacity-0 shadow-xl transition-all duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
				{links.map((link) => (
					<LanguageOption link={link} current={current} variant="menu" />
				))}
			</div>
		</div>
	))}

<script>
	import { setDisclosure } from '../lib/disclosure'

	function bindLanguageMenu(group: HTMLElement): void {
		const button = group.querySelector('button')
		if (button === null) {
			return
		}
		group.addEventListener('mouseenter', () => setDisclosure(button, true))
		group.addEventListener('mouseleave', () =>
			setDisclosure(button, group.matches(':focus-within'))
		)
		group.addEventListener('focusin', () => setDisclosure(button, true))
		group.addEventListener('focusout', () =>
			setDisclosure(button, group.matches(':hover') || group.matches(':focus-within'))
		)
	}

	document.querySelectorAll<HTMLElement>('[data-language-menu]').forEach(bindLanguageMenu)
</script>
