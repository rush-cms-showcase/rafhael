---
import { LINK_ICONS } from '../../lib/icons'
import type { HeroSection } from '../../lib/home-sections'
import { splitHeroText } from '../../lib/home-sections'
import { safeHref } from '../../lib/safe-href'
import Container from '../container.astro'
import MaybeLink from '../maybe-link.astro'

type Props = {
	section: HeroSection
}

const { section } = Astro.props
const { lead, comma, rest } = splitHeroText(section.text)
const links = section.links.map((link) => ({
	...link,
	href: safeHref(link.url),
	Icon: link.icon === undefined ? undefined : LINK_ICONS[link.icon]
}))
---

<Container class="pt-16 pb-4 lg:pt-28">
	<h1 class="max-w-[62rem] font-serif text-3xl leading-[1.18] lg:text-6xl lg:leading-[1.12]">
		<span class="font-bold text-text-main">{lead}</span>
		{section.avatar !== undefined && (
			<img
				src={section.avatar}
				alt=""
				width="64"
				height="64"
				class="mr-[0.08em] ml-[0.2em] inline-block size-[1.05em] rounded-full border-2 border-primary align-[-0.17em] object-cover lg:border-3"
			/>
		)}
		{comma && <span class="font-bold text-text-main">,</span>}
		{rest !== '' && (
			<>
				{' '}
				<span class="font-normal text-text-muted">{rest}</span>
			</>
		)}
	</h1>
	{links.length > 0 && (
		<p class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm text-text-muted">
			{links.map(({ name, href, Icon }) => (
				<MaybeLink
					href={href}
					class="inline-flex items-center gap-1.5"
					linkClass="transition-colors hover:text-primary"
					textClass="text-text-subtle"
				>
					{Icon && <Icon class="size-4" />}
					{name}
				</MaybeLink>
			))}
		</p>
	)}
</Container>
