---
import type { Entry, LocaleCode, RushUrls } from '@rushcms/client'
import { loopLayout } from '../../lib/home-sections'
import type { LoopSection } from '../../lib/home-sections'
import { collectionHref } from '../../lib/routing'
import CaseRows from '../case-rows.astro'
import Container from '../container.astro'
import EntryGrid from '../entry-grid.astro'
import SectionTitle from './section-title.astro'

type Props = {
	section: LoopSection
	entries: Entry[]
	locale: LocaleCode
	urls: RushUrls
}

const { section, entries, locale, urls } = Astro.props
const layout = loopLayout(section.type, section.disposition)
const seeAllHref = collectionHref(urls, section.type, locale)
---

{entries.length > 0 && (
	<Container class="pt-20 last:pb-24 lg:pt-28">
		<SectionTitle title={section.title} locale={locale} seeAllHref={seeAllHref} />
		{layout === 'rows' ? (
			<CaseRows entries={entries} urls={urls} />
		) : (
			<EntryGrid entries={entries} locale={locale} urls={urls} layout={layout} />
		)}
	</Container>
)}
