---
import RushImage from '@rushcms/astro/components/rush-image.astro'
import type { LocaleCode, Media } from '@rushcms/client'
import {
	GALLERY_ASPECT_RATIO,
	GALLERY_SIZES,
	GALLERY_THUMB_SIZES,
	GALLERY_THUMB_WIDTHS,
	GALLERY_WIDTHS,
	LIGHTBOX_SIZES,
	LIGHTBOX_WIDTHS
} from '../lib/cover-sizes'
import { Icons } from '../lib/icons'
import { formatLabel, labelsFor } from '../lib/labels'

type Props = {
	media: Media[]
	title: string
	locale: LocaleCode
}

type GalleryImage = {
	media: Media
	alt: string
}

const { media, title, locale } = Astro.props
const labels = labelsFor(locale)
const total = media.length
const images: GalleryImage[] = media.map((item, index) => ({
	media: item,
	alt:
		item.alt !== undefined && item.alt.trim() !== ''
			? item.alt
			: formatLabel(labels.galleryImageAlt, {
					title,
					n: String(index + 1),
					total: String(total)
				})
}))
const control =
	'flex size-11 items-center justify-center rounded-full border border-border bg-bg-elevated/80 text-text-main backdrop-blur-sm transition-colors hover:border-primary/60 hover:text-primary'
---

{total > 0 && (
	<div data-gallery class="flex flex-col gap-3">
		<div class="relative aspect-[16/10] overflow-hidden rounded-2xl border border-border bg-bg-card">
			{images.map((image, index) => (
				<a
					href={image.media.url}
					data-gallery-slide
					hidden={index !== 0}
					class="group block size-full cursor-zoom-in"
				>
					<RushImage
						media={image.media}
						alt={image.alt}
						sizes={GALLERY_SIZES}
						widths={GALLERY_WIDTHS}
						aspectRatio={GALLERY_ASPECT_RATIO}
						priority={index === 0}
						class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
					/>
					<span class="absolute right-3 bottom-3 flex size-9 items-center justify-center rounded-full border border-border/60 bg-bg/80 text-text-main backdrop-blur-sm transition-colors group-hover:text-primary">
						<Icons.maximize class="size-4" aria-hidden="true" />
						<span class="sr-only">{labels.galleryOpen}</span>
					</span>
				</a>
			))}
		</div>
		{total > 1 && (
			<ul data-gallery-thumbs class="grid grid-cols-5 gap-2">
				{images.map((image, index) => (
					<li>
						<button
							type="button"
							data-gallery-thumb
							aria-label={image.alt}
							aria-current={index === 0 ? 'true' : undefined}
							class="block aspect-[16/10] w-full overflow-hidden rounded-lg border border-border opacity-60 ring-primary ring-offset-2 ring-offset-bg transition hover:opacity-100 aria-[current=true]:opacity-100 aria-[current=true]:ring-2"
						>
							<RushImage
								media={image.media}
								alt=""
								sizes={GALLERY_THUMB_SIZES}
								widths={GALLERY_THUMB_WIDTHS}
								aspectRatio={GALLERY_ASPECT_RATIO}
								class="size-full object-cover"
							/>
						</button>
					</li>
				))}
			</ul>
		)}
		<dialog
			data-gallery-dialog
			aria-label={title}
			class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-transparent p-0 text-text-main backdrop:bg-bg/95 backdrop:backdrop-blur-md"
		>
			<div class="flex size-full flex-col">
				<div class="flex items-center justify-between px-4 py-4 sm:px-6">
					<p
						data-gallery-counter
						aria-live="polite"
						class="text-sm text-text-muted tabular-nums"
					>
						1 / {total}
					</p>
					<button
						type="button"
						data-gallery-close
						aria-label={labels.galleryClose}
						class={control}
					>
						<Icons.x class="size-5" aria-hidden="true" />
					</button>
				</div>
				<div class="relative min-h-0 flex-1">
					<div
						data-gallery-stage
						class="size-full touch-pan-y px-4 pb-6 select-none sm:px-20 [&>img]:size-full [&>img]:object-contain"
					></div>
					{total > 1 && (
						<>
							<button
								type="button"
								data-gallery-step="-1"
								aria-label={labels.galleryPrevious}
								class:list={[control, 'absolute top-1/2 left-4 -translate-y-1/2']}
							>
								<Icons.chevron_left class="size-5" aria-hidden="true" />
							</button>
							<button
								type="button"
								data-gallery-step="1"
								aria-label={labels.galleryNext}
								class:list={[control, 'absolute top-1/2 right-4 -translate-y-1/2']}
							>
								<Icons.chevron_right class="size-5" aria-hidden="true" />
							</button>
						</>
					)}
				</div>
			</div>
			{images.map((image) => (
				<template data-gallery-large>
					<RushImage
						media={image.media}
						alt={image.alt}
						sizes={LIGHTBOX_SIZES}
						widths={LIGHTBOX_WIDTHS}
						aspectRatio={GALLERY_ASPECT_RATIO}
						loading="eager"
						decoding="async"
					/>
				</template>
			))}
		</dialog>
	</div>
)}

<script>
	import '../scripts/gallery'
</script>
