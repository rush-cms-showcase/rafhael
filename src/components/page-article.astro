---
import type { Entry } from '@rushcms/client'
import ArticleShell from './article-shell.astro'
import ArticleTitle from './article-title.astro'
import Prose from './prose.astro'

type Props = {
	entry: Entry
}

const { entry } = Astro.props
---

<ArticleShell kind="page">
	<ArticleTitle title={entry.title} tone="plain" />
	<Prose entry={entry} />
</ArticleShell>
