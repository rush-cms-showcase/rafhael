---
import Prose from './prose.astro'

type Props = {
	title: string
	html: string
}

const { title, html } = Astro.props
---

<article class="mx-auto flex max-w-3xl flex-col gap-10 px-3 pt-10 pb-16 lg:px-6 lg:pt-14 lg:pb-24">
	<h1 class="font-serif text-4xl leading-tight font-bold text-text-main text-balance lg:text-5xl">
		{title}
	</h1>
	<Prose html={html} />
</article>
