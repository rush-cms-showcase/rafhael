---
import type { Entry, LocaleCode } from '@rushcms/client'
import { projectMeta } from '../lib/entry-data'
import { labelsFor } from '../lib/labels'
import ArticleShell from './article-shell.astro'
import ArticleTitle from './article-title.astro'
import EntryExcerpt from './entry-excerpt.astro'
import ProjectAside from './project-aside.astro'
import Prose from './prose.astro'

type Props = {
	entry: Entry
	locale: LocaleCode
}

const { entry, locale } = Astro.props
const meta = projectMeta(entry, labelsFor(locale))
const hasAside = meta.gallery.length > 0 || meta.distribution.length > 0 || meta.links.length > 0
---

<ArticleShell kind="project">
	<header class="flex flex-col gap-8">
		<ArticleTitle title={entry.title} tone="accent" />
		<EntryExcerpt excerpt={entry.excerpt} />
	</header>
	<div class:list={['grid gap-12', hasAside && 'lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]']}>
		<Prose entry={entry} size="lg" />
		{hasAside && (
			<ProjectAside
				meta={meta}
				title={entry.title}
				locale={locale}
				class="order-first lg:order-none lg:self-start [@media(min-height:760px)]:lg:sticky [@media(min-height:760px)]:lg:top-28"
			/>
		)}
	</div>
</ArticleShell>
