---
import RushImage from '@rushcms/astro/components/rush-image.astro'
import type { Entry } from '@rushcms/client'
import { projectMeta } from '../lib/entry-data'
import { Icons } from '../lib/icons'
import type { Labels } from '../lib/labels'
import Prose from './prose.astro'

type Props = {
	entry: Entry
	html: string
	backHref: string
	labels: Labels
}

const { entry, html, backHref, labels } = Astro.props
const { linkUrl, linkLabel } = projectMeta(entry)
const cover = entry.featured_image?.url === undefined ? undefined : entry.featured_image
---

<article class="mx-auto flex max-w-4xl flex-col gap-10 px-3 py-16 lg:px-6 lg:py-24">
	<a
		href={backHref}
		class="group inline-flex items-center gap-2 self-start text-sm font-medium text-text-muted transition-colors hover:text-primary"
	>
		<Icons.arrow_left class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
		{labels.allProjects}
	</a>
	<h1 class="font-serif text-4xl leading-tight font-bold text-primary text-balance lg:text-6xl">
		{entry.title}
	</h1>
	{cover && (
		<RushImage
			media={cover}
			alt={cover.alt || entry.title}
			class="aspect-video w-full rounded-2xl object-cover"
		/>
	)}
	<Prose html={html} />
	{linkUrl !== undefined && (
		<a
			href={linkUrl}
			target="_blank"
			rel="noopener"
			class="inline-flex items-center gap-2 self-start rounded-full bg-primary px-6 py-3 font-bold text-white transition-opacity hover:opacity-90"
		>
			{linkLabel ?? labels.openProject}
			<Icons.external_link class="h-4 w-4" />
		</a>
	)}
</article>
