---
import type { Entry, LocaleCode } from '@rushcms/client'
import { CARD_ASPECT_RATIO, ENTRY_COVER_SIZES } from '../lib/cover-sizes'
import { projectMeta } from '../lib/entry-data'
import { Icons } from '../lib/icons'
import { labelsFor } from '../lib/labels'
import ArticleShell from './article-shell.astro'
import ArticleTitle from './article-title.astro'
import EntryCover from './entry-cover.astro'
import Prose from './prose.astro'

type Props = {
	entry: Entry
	locale: LocaleCode
}

const { entry, locale } = Astro.props
const { linkUrl, linkLabel } = projectMeta(entry)
---

<ArticleShell kind="project">
	<ArticleTitle title={entry.title} tone="accent" />
	<EntryCover
		entry={entry}
		sizes={ENTRY_COVER_SIZES}
		aspectRatio={CARD_ASPECT_RATIO}
		priority
		class="aspect-video w-full rounded-2xl object-cover"
	/>
	<Prose entry={entry} />
	{linkUrl !== undefined && (
		<a
			href={linkUrl}
			target="_blank"
			rel="noopener"
			class="inline-flex items-center gap-2 self-start rounded-full bg-primary px-6 py-3 font-bold text-white transition-opacity hover:opacity-90"
		>
			{linkLabel ?? labelsFor(locale).openProject}
			<Icons.external_link class="size-4" />
		</a>
	)}
</ArticleShell>
