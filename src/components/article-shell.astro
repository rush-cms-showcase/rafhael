---
import { ENTRY_WIDTHS } from '../lib/entry-width'
import type { EntryKind } from '../lib/entry-width'

type Props = {
	kind: EntryKind
}

const { kind } = Astro.props
---

<article
	class:list={[
		'mx-auto flex flex-col gap-10 px-6 pt-10 pb-16 lg:pt-14 lg:pb-24',
		ENTRY_WIDTHS[kind]
	]}
>
	<slot />
</article>
