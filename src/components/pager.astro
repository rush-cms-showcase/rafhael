---
import type { CollectionRef, LocaleCode, RushUrls } from '@rushcms/client'
import { Icons } from '../lib/icons'
import { labelsFor } from '../lib/labels'

type Props = {
	collection: CollectionRef
	locale: LocaleCode
	current: number
	last: number
	urls: RushUrls
}

const { collection, locale, current, last, urls } = Astro.props
const labels = labelsFor(locale)
const previousHref = current > 1 ? urls.collection(collection, locale, current - 1) : undefined
const nextHref = current < last ? urls.collection(collection, locale, current + 1) : undefined
---

{last > 1 && (
	<nav class="flex items-center justify-between gap-4 pt-10" aria-label="Pagination">
		{previousHref ? (
			<a
				href={previousHref}
				rel="prev"
				class="inline-flex items-center gap-2 text-text-muted transition-colors hover:text-primary"
			>
				<Icons.arrow_left class="h-4 w-4" />
				{labels.previous}
			</a>
		) : (
			<span />
		)}
		<span class="text-sm text-text-subtle">
			{current} / {last}
		</span>
		{nextHref ? (
			<a
				href={nextHref}
				rel="next"
				class="inline-flex items-center gap-2 text-text-muted transition-colors hover:text-primary"
			>
				{labels.next}
				<Icons.arrow_right class="h-4 w-4" />
			</a>
		) : (
			<span />
		)}
	</nav>
)}
