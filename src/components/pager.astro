---
import type { LocaleCode } from '@rushcms/client'
import { Icons } from '../lib/icons'
import { labelsFor } from '../lib/labels'
import type { PageUrl } from '../lib/routing'

type Props = {
	locale: LocaleCode
	current: number
	last: number
	pageUrl: PageUrl
}

const { locale, current, last, pageUrl } = Astro.props
const labels = labelsFor(locale)
const previousHref = current > 1 ? pageUrl(current - 1) : undefined
const nextHref = current < last ? pageUrl(current + 1) : undefined
const buttonClass =
	'flex items-center gap-2 px-6 py-3 rounded-full bg-bg-elevated border border-border hover:border-primary hover:text-primary transition-all font-medium'
---

{last > 1 && (
	<nav class="flex justify-center gap-4 mt-16 animate-fade-in-up" aria-label={labels.pagination}>
		{previousHref && (
			<a href={previousHref} rel="prev" class={buttonClass}>
				<Icons.chevron_left class="size-5" />
				{labels.previous}
			</a>
		)}
		<span class="flex items-center px-4 font-serif font-bold text-text-muted">
			{current} / {last}
		</span>
		{nextHref && (
			<a href={nextHref} rel="next" class={buttonClass}>
				{labels.next}
				<Icons.chevron_right class="size-5" />
			</a>
		)}
	</nav>
)}
