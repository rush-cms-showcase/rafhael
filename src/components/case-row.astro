---
import type { Entry } from '@rushcms/client'
import { caseMeta } from '../lib/entry-data'
import { Icons } from '../lib/icons'
import CaseStack from './case-stack.astro'

type Props = {
	entry: Entry
	href: string
	detailed: boolean
}

const { entry, href, detailed } = Astro.props
const { stack } = caseMeta(entry)
---

<a
	href={href}
	class="group grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-6 py-6 lg:gap-x-8 lg:py-7"
>
	<span class="flex min-w-0 flex-col gap-3">
		<span class="relative font-serif text-lg leading-snug text-pretty text-text-main transition-colors group-hover:text-primary group-focus-visible:text-primary xl:text-xl">
			<span
				data-accent
				aria-hidden="true"
				class="absolute top-[0.3em] -left-2 h-[1em] w-0.5 origin-center scale-y-50 rounded-full bg-primary opacity-40 transition duration-300 group-hover:scale-y-100 group-hover:opacity-100 group-focus-visible:scale-y-100 group-focus-visible:opacity-100 lg:-left-4"
			></span>
			{entry.title}
		</span>
		{detailed && entry.excerpt && (
			<span class="max-w-2xl text-base text-pretty text-text-muted">{entry.excerpt}</span>
		)}
		{detailed && <CaseStack stack={stack} />}
	</span>
	<Icons.arrow_right class="size-5 self-center text-text-subtle transition group-hover:translate-x-1.5 group-hover:text-primary group-focus-visible:translate-x-1.5 group-focus-visible:text-primary" />
</a>
