---
import type { LocaleCode } from '@rushcms/client'
import type { ProjectMeta } from '../lib/entry-data'
import { Icons } from '../lib/icons'
import { labelsFor } from '../lib/labels'
import Fact from './fact.astro'
import ProjectGallery from './project-gallery.astro'

type Props = {
	meta: ProjectMeta
	title: string
	locale: LocaleCode
	class?: string | undefined
}

const { meta, title, locale, class: className } = Astro.props
const labels = labelsFor(locale)
const hasDetails = meta.distribution.length > 0 || meta.links.length > 0
---

<aside class:list={['flex flex-col gap-8', className]}>
	<ProjectGallery media={meta.gallery} title={title} locale={locale} />
	{hasDetails && (
		<div class="flex flex-col gap-5 border-t border-border pt-6">
			{meta.distribution.length > 0 && (
				<dl>
					<Fact label={labels.projectDistribution}>{meta.distribution.join(', ')}</Fact>
				</dl>
			)}
			{meta.links.length > 0 && (
				<ul class="flex flex-col gap-2.5">
					{meta.links.map((link) => (
						<li>
							<a
								href={link.href}
								target="_blank"
								rel="noopener"
								class="group inline-flex max-w-full items-center gap-2.5 text-sm text-text-muted transition-colors hover:text-primary"
							>
								<link.icon class="size-4 shrink-0" aria-hidden="true" />
								<span class="min-w-0 truncate">{link.label}</span>
								{link.icon !== Icons.external_link && (
									<Icons.external_link
										class="size-3.5 shrink-0 opacity-50 transition-opacity group-hover:opacity-100"
										aria-hidden="true"
									/>
								)}
							</a>
						</li>
					))}
				</ul>
			)}
		</div>
	)}
</aside>
