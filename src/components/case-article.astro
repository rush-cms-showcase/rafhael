---
import type { Entry, LocaleCode } from '@rushcms/client'
import ArticleShell from './article-shell.astro'
import CaseHeader from './case-header.astro'
import Prose from './prose.astro'

type Props = {
	entry: Entry
	locale: LocaleCode
}

const { entry, locale } = Astro.props
---

<ArticleShell kind="case">
	<CaseHeader entry={entry} locale={locale} />
	<Prose entry={entry} />
</ArticleShell>
