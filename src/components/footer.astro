---
import type { LocaleCode } from '@rushcms/client'
import { labelsFor } from '../lib/labels'
import { LINK_ICONS } from '../lib/icons'
import type { LinkableNavigation } from '../lib/locale'
import type { ContactLink } from '../lib/site-options'
import BrandName from './brand-name.astro'
import Container from './container.astro'
import FooterCredits from './footer-credits.astro'
import NavLink from './nav-link.astro'
import SiteLogo from './site-logo.astro'

type Props = {
	name: string
	locale: LocaleCode
	homeUrl: string
	links: LinkableNavigation[]
	year: number
	logoUrl?: string | undefined
	contacts?: ContactLink[]
	floatingAction?: boolean
}

const {
	name,
	locale,
	homeUrl,
	links,
	year,
	logoUrl,
	contacts = [],
	floatingAction = false
} = Astro.props
const labels = labelsFor(locale)
const copyright = `© ${year} ${name}. ${labels.rights}`
---

<footer class="flex flex-col items-center border-t border-border-subtle bg-bg">
	<div class="w-full py-12">
		<Container class="relative flex flex-col items-center justify-between gap-6 md:flex-row">
			<div class="flex items-center gap-2">
				<BrandName name={name} class="text-xl" />
			</div>

			<div class="lg:absolute lg:top-1/2 lg:left-1/2 lg:mt-[-32px] lg:ml-[-32px]">
				<SiteLogo logoUrl={logoUrl} name={name} size={64} />
			</div>

			<div class="flex flex-wrap justify-center gap-6">
				{contacts.map(({ kind, href }) => {
					const Icon = LINK_ICONS[kind]
					return (
						<a
							href={href}
							aria-label={labels[kind]}
							class="text-text-muted transition-colors hover:text-primary"
						>
							<Icon class="size-5" />
						</a>
					)
				})}
				{links.map((link) => (
					<NavLink
						link={link}
						class="text-sm text-text-muted transition-colors hover:text-primary"
					/>
				))}
			</div>
		</Container>
	</div>
	<small
		class:list={[
			'w-full border-t border-border-subtle/40 p-4 text-sm text-text-muted lg:p-8',
			floatingAction && 'pb-24 lg:pb-32'
		]}
	>
		<Container class="flex flex-col items-center gap-2 lg:flex-row lg:justify-between">
			<span class="text-center lg:text-left">{copyright}</span>
			<FooterCredits name={name} homeUrl={homeUrl} locale={locale} />
		</Container>
	</small>
</footer>
