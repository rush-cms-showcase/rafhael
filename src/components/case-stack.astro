---
type Props = {
	stack: string[]
}

const { stack } = Astro.props
---

{stack.length > 0 && (
	<ul class="flex flex-wrap gap-2">
		{stack.map((item) => (
			<li class="rounded-full border border-border bg-bg-elevated px-3 py-1 text-xs font-medium text-text-muted">
				{item}
			</li>
		))}
	</ul>
)}
